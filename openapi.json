{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent-ready chess API",
    "description": "A small chess API used to show how one contract feeds an SDK, an MCP server and docs.",
    "version": "1.0.0"
  },
  "paths": {
    "/games": {
      "post": {
        "tags": [
          "games"
        ],
        "summary": "Start a new game",
        "operationId": "create_game",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Board"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/games/{id}": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "Read the current board",
        "description": "Returns the position, whose turn it is and every legal move.",
        "operationId": "get_board",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Board"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/games/{id}/moves": {
      "post": {
        "tags": [
          "games"
        ],
        "summary": "Play one move",
        "description": "Play one move in SAN, for example \"e4\" or \"O-O\". Illegal moves return 422 with a code that says why.",
        "operationId": "make_move",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Move"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Board"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/games/{id}/reset": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Reset a game to the start position (admin only)",
        "operationId": "reset_game",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Board"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveError"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Board": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "fen": {
            "type": "string",
            "title": "Fen",
            "description": "Board position in FEN."
          },
          "board_version": {
            "type": "integer",
            "title": "Board Version"
          },
          "next_turn": {
            "type": "string",
            "enum": [
              "white",
              "black"
            ],
            "title": "Next Turn"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "checkmate",
              "stalemate",
              "draw"
            ],
            "title": "Status"
          },
          "legal_moves": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Legal Moves",
            "description": "Legal moves for the side to move, in SAN."
          }
        },
        "type": "object",
        "required": [
          "id",
          "fen",
          "board_version",
          "next_turn",
          "status",
          "legal_moves"
        ],
        "title": "Board"
      },
      "Move": {
        "properties": {
          "move": {
            "type": "string",
            "title": "Move",
            "description": "Move in SAN, for example \"e4\", \"Nf3\" or \"O-O\".",
            "examples": [
              "O-O"
            ]
          },
          "board_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Board Version",
            "description": "Version you last read. If it is out of date, the move is rejected with STALE_BOARD."
          }
        },
        "type": "object",
        "required": [
          "move"
        ],
        "title": "Move"
      },
      "MoveError": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "CASTLING_THROUGH_CHECK",
              "ILLEGAL_MOVE",
              "NOT_YOUR_TURN",
              "STALE_BOARD",
              "GAME_NOT_FOUND",
              "FORBIDDEN",
              "UNAUTHORIZED"
            ],
            "title": "Code",
            "description": "Stable, machine-readable error code. Branch on this, not on detail."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Human-readable explanation of why the request failed."
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint",
            "description": "What to do next."
          }
        },
        "type": "object",
        "required": [
          "code",
          "detail"
        ],
        "title": "MoveError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Demo tokens: player-token, viewer-token, admin-token",
        "scheme": "bearer"
      }
    }
  }
}
